<% set coverage_paths = slot("coverage_paths", optional=true) %>name: Coverage

on:
  push:
    branches: [main]
<% if coverage_paths %><$ coverage_paths $><% endif %>  pull_request:
    branches: [main]
<% if coverage_paths %><$ coverage_paths $><% endif %>  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: coverage-${{ github.ref }}
  cancel-in-progress: true

jobs:
  coverage:
    if: ${{ github.event_name != 'workflow_dispatch' || github.ref == 'refs/heads/main' }}
    name: Coverage
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    env:
      MISE_TASK_RUN_AUTO_INSTALL: "false"
      MISE_LOCKED: "1"
      MISE_ENV: "ci"
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false

      - uses: jdx/mise-action@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          add_shims_to_path: true
          cache_key: "mise-coverage-${{ hashFiles('mise.ci.toml', 'mise.ci.lock') }}"
<$ slot("coverage_adapter", optional=true) $>
      - name: Resolve Codecov CLI
        id: codecov-cli
        run: echo "path=$(mise which codecovcli)" >> "$GITHUB_OUTPUT"

      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@v7
        with:
          binary: ${{ steps.codecov-cli.outputs.path }}
          files: ${{ steps.coverage.outputs.report }}
          disable_search: true
          fail_ci_if_error: true
          use_oidc: ${{ github.event_name != 'pull_request' }}

      - name: Summarize coverage failure
        if: ${{ failure() }}
        run: |
          {
            echo "## Coverage upload failed"
            echo
            echo "Coverage report generation or Codecov upload failed. Inspect the preceding logs."
          } >> "${GITHUB_STEP_SUMMARY}"
