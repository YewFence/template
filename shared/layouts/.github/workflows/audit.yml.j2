<% set audit_paths = slot("audit_paths", optional=true) %><% set audit_install_args = slot("audit_install_args", optional=true) %>name: Security Audit

on:
  push:
    branches: [main]
<% if audit_paths %><$ audit_paths $><% endif %>  pull_request:
    branches: [main]
<% if audit_paths %><$ audit_paths $><% endif %>  schedule:
    - cron: "17 9 * * 1"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: audit-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  audit:
    name: Audit
    runs-on: ubuntu-latest
    env:
      MISE_TASK_RUN_AUTO_INSTALL: "false"
      MISE_LOCKED: "1"
      MISE_ENV: "ci"
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false

      - uses: jdx/mise-action@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
<$ audit_install_args $>          add_shims_to_path: true
          cache_key: "mise-audit-<% if audit_install_args %>{{install_args_hash}}-<% endif %>{{file_hash}}"
<$ slot("audit_cache", optional=true) $>
      - name: Audit
        run: mise run audit
