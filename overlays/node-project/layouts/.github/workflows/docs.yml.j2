name: Deploy Docs

on:
  push:
    branches: [main]
    paths:
      - "docs/**"
  workflow_dispatch:

permissions: {}

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
      pages: read
    env:
      MISE_TASK_RUN_AUTO_INSTALL: "false"
      MISE_LOCKED: "1"
    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          ref: main
          persist-credentials: false

      - name: Setup mise
        uses: jdx/mise-action@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          install_args: node aube
          add_shims_to_path: true
          cache_key: "mise-docs-{{file_hash}}"

      - name: Setup Pages
        uses: actions/configure-pages@v6

      - name: Resolve aube store path
        id: aube-store
        run: echo "path=$(aube store path --silent)" >> "${GITHUB_OUTPUT}"

      - uses: actions/cache@v6
        with:
          path: ${{ steps.aube-store.outputs.path }}
          key: aube-${{ runner.os }}-${{ hashFiles('docs/aube-lock.yaml') }}
          restore-keys: |
            aube-${{ runner.os }}-

      - name: Build
        run: mise run docs:build

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v5
        with:
          path: docs/.vitepress/dist

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    name: Deploy
    permissions:
      pages: write
      id-token: write
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
