
coverage:
  name: Coverage
  runs-on: ubuntu-latest
  permissions:
    contents: read
    id-token: write
  env:
    MISE_TASK_RUN_AUTO_INSTALL: "false"
    MISE_LOCKED: "1"
    MISE_ENV: "ci"
  steps:
    - uses: actions/checkout@v7
      with:
        persist-credentials: false

    - uses: jdx/mise-action@v4
      with:
        github_token: ${{ secrets.GITHUB_TOKEN }}
        add_shims_to_path: true
        cache_key: "mise-coverage-{{file_hash}}"

    - uses: Swatinem/rust-cache@v2
      with:
        shared-key: rust-coverage

    - name: Generate coverage report
      run: mise run coverage

    - name: Upload coverage to Codecov
      uses: codecov/codecov-action@v7
      with:
        files: lcov.info
        disable_search: true
        fail_ci_if_error: true
        use_oidc: true

    - name: Summarize coverage failure
      if: ${{ failure() }}
      run: |
        {
          echo "## Coverage upload failed"
          echo
          echo "Coverage report generation or Codecov upload failed. Inspect the preceding step logs."
        } >> "${GITHUB_STEP_SUMMARY}"
