
  publish-container:
    name: Publish container image
    needs: [version, release]
    if: ${{ needs.version.outputs.should_release == 'true' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    env:
      MISE_ENV: "ci"
      MISE_LOCKED: "1"
      MISE_TASK_RUN_AUTO_INSTALL: "false"
    steps:
      - name: Checkout code
        uses: actions/checkout@v7
        with:
          persist-credentials: false
          ref: ${{ needs.version.outputs.checkout_ref }}

      - name: Setup mise
        uses: jdx/mise-action@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          install_args: go aqua:ko-build/ko
          add_shims_to_path: true
          cache_key: "mise-publish-container-{{install_args_hash}}-{{file_hash}}"

      - name: Authenticate with GHCR
        env:
          GHCR_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: printf '%s' "${GHCR_TOKEN}" | ko login ghcr.io --username "${GITHUB_ACTOR}" --password-stdin

      - name: Publish container image
        env:
          CONTAINER_IMAGE_REPOSITORY: ghcr.io/{{GITHUB_OWNER}}/{{REPO_NAME}}
          RELEASE_TAG: ${{ needs.version.outputs.tag }}
          RELEASE_PRERELEASE: ${{ needs.version.outputs.prerelease }}
        run: mise run container:publish
