
    - uses: actions/cache@v6
      with:
        path: |
          ~/.cache/go-build
          ~/go/pkg/mod
        key: go-coverage-${{ runner.os }}-${{ hashFiles('go.sum') }}
        restore-keys: |
          go-coverage-${{ runner.os }}-

    - name: Generate coverage report
      id: coverage
      run: |
        mise run coverage
        echo "report=coverage.out" >> "$GITHUB_OUTPUT"
